{
    "name": "picaflor/propstack-lite",
    "description": "Propstack Listings Lite – WordPress-Integration für Propstack-Immobilien (Picaflor Immobilien).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PropstackLite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PropstackLite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
